# Application
# APP_NAME=s3-manager
# API_V1_PREFIX=/api

# Database
# DATABASE_URL=sqlite:////absolute/path/to/backend/app.db
# DATABASE_URL=postgresql+psycopg://s3manager:s3manager@localhost:5432/s3manager

# CORS (JSON list)
# CORS_ORIGINS=["http://127.0.0.1:8080", "http://localhost:8080"]

# Auth / JWT
# FERNET_KEY=change-me  # replace with strong random value in production
# JWT_KEYS=["change-me"]  # replace with strong random value in production
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_MINUTES=20160
# LOG_LEVEL=INFO
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
# REFRESH_TOKEN_COOKIE_NAME=refresh_token
# REFRESH_TOKEN_COOKIE_PATH=/api/auth
# REFRESH_TOKEN_COOKIE_DOMAIN=
# REFRESH_TOKEN_COOKIE_SECURE=false  # set true in production
# REFRESH_TOKEN_COOKIE_SAMESITE=lax

# App settings bootstrap import (optional)
# JSON file imported only when the app_settings DB row is missing.
# Live reads/writes use the database; DB errors are not hidden by this file.
# APP_SETTINGS_PATH=
#
# Feature kill-switch overrides (optional, force value when set)
# FEATURE_MANAGER_ENABLED=true
# FEATURE_BROWSER_ENABLED=true
# FEATURE_PORTAL_ENABLED=false
# FEATURE_CEPH_ADMIN_ENABLED=false
# FEATURE_STORAGE_OPS_ENABLED=false
# FEATURE_BILLING_ENABLED=false
# FEATURE_ENDPOINT_STATUS_ENABLED=true
#
# Shared secret for internal cron endpoints
# INTERNAL_CRON_TOKEN=change-me-strong
#
# Scheduler service knobs (Docker Compose)
# HEALTHCHECK_CRON_SCHEDULE=*/5 * * * *
# BILLING_CRON_SCHEDULE=0 2 * * *
# QUOTA_MONITOR_CRON_SCHEDULE=0 * * * *
# USAGE_HISTORY_CRON_SCHEDULE=0 3 * * *
#
# Shared history retention (quota + billing)
# BILLING_DAILY_RETENTION_DAYS=365
# QUOTA_HISTORY_HOURLY_RETENTION_DAYS=30
# QUOTA_HISTORY_DAILY_RETENTION_DAYS=365
#
# Quota notifications SMTP secret (non-secret SMTP fields are in app settings)
# SMTP_PASSWORD=

# Credentials encryption at rest
# CREDENTIAL_KEY=change-me  # replace with strong random value in production
# CREDENTIAL_KEYS=["change-me"]  # replace with strong random value in production

# Env-managed endpoints (JSON array, read-only in UI)
# When set, the endpoints list becomes read-only in the UI.
# ENV_STORAGE_ENDPOINTS='[{"name":"Ceph-Prod","endpoint_url":"https://rgw.example.com","provider":"CEPH","region":"us-east-1","force_path_style":false,"verify_tls":true,"features":{"admin":{"enabled":true},"usage":{"enabled":true},"metrics":{"enabled":true},"replication":{"enabled":false}},"admin_access_key":"AKIA...","admin_secret_key":"SECRET...","supervision_access_key":"AKIA...","supervision_secret_key":"SECRET...","ceph_admin_access_key":"AKIA...","ceph_admin_secret_key":"SECRET..."}]'

# S3 / RGW seed connection
# SEED_S3_ENDPOINT=http://localhost:9000
# SEED_S3_ACCESS_KEY=minio
# SEED_S3_SECRET_KEY=minio123
# SEED_S3_REGION=us-east-1

# Default endpoint features (YAML or JSON)
# Example:
# SEED_S3_ENDPOINT_FEATURES='{"features":{"admin":{"enabled":true},"sts":{"enabled":true},"usage":{"enabled":true},"metrics":{"enabled":false},"static_website":{"enabled":true},"replication":{"enabled":false}}}'

# RGW admin ops (defaults to seed S3 values when empty)
# SEED_RGW_ADMIN_ACCESS_KEY=
# SEED_RGW_ADMIN_SECRET_KEY=
# STORAGE_INTERACTIVE_CONNECT_TIMEOUT_SECONDS=2
# STORAGE_INTERACTIVE_READ_TIMEOUT_SECONDS=5
# STORAGE_INTERACTIVE_MAX_ATTEMPTS=2
# RGW_ADMIN_TIMEOUT_SECONDS=10
# RGW_ADMIN_PROBE_TIMEOUT_SECONDS=3
# RGW_ADMIN_BUCKET_LIST_STATS_TIMEOUT_SECONDS=60

# Supervision access keys (usage stats)
# SEED_SUPERVISION_ACCESS_KEY=
# SEED_SUPERVISION_SECRET_KEY=

# Ceph Admin dedicated access keys (advanced cluster-wide ceph-admin workspace)
# SEED_CEPH_ADMIN_ACCESS_KEY=
# SEED_CEPH_ADMIN_SECRET_KEY=

# Default super-admin seed
# SEED_SUPER_ADMIN_EMAIL=admin@example.com
# SEED_SUPER_ADMIN_PASSWORD=changeme  # bootstrap only, rotate immediately
# SEED_SUPER_ADMIN_FULL_NAME=Admin
# SEED_SUPER_ADMIN_MODE=if_empty  # if_empty|if_missing|disabled

# Ceph functional tests (optional)
# CEPH_TEST_BACKEND_BASE_URL=http://localhost:8000/api
# CEPH_TEST_SUPERADMIN_EMAIL=admin@example.com
# CEPH_TEST_SUPERADMIN_PASSWORD=changeme
# CEPH_TEST_RESOURCE_PREFIX=ceph-functional
# CEPH_TEST_CEPH_ADMIN_REQUIRE_DEFAULT_ENDPOINT=true
# CEPH_TEST_CEPH_ADMIN_ENDPOINT_NAME=Default

# OIDC
# Providers can also be managed from Admin > Settings > Authentication.
# Providers defined here override and lock any UI provider with the same key.
# OIDC_STATE_TTL_SECONDS remains runtime-only.
# OIDC_STATE_TTL_SECONDS=600
# Example provider:
# OIDC_PROVIDERS__default__DISPLAY_NAME=Example
# OIDC_PROVIDERS__default__DISCOVERY_URL=https://issuer/.well-known/openid-configuration
# OIDC_PROVIDERS__default__CLIENT_ID=client-id
# OIDC_PROVIDERS__default__CLIENT_SECRET=client-secret
# OIDC_PROVIDERS__default__REDIRECT_URI=http://localhost:5173/auth/oidc/callback
# OIDC_PROVIDERS__default__SCOPES=openid,email,profile
# OIDC_PROVIDERS__default__PROMPT=login
# OIDC_PROVIDERS__default__ENABLED=true
# OIDC_PROVIDERS__default__ICON_URL=
# OIDC_PROVIDERS__default__USE_PKCE=true
# OIDC_PROVIDERS__default__USE_NONCE=true

# LDAP
# Providers can also be managed from Admin > Settings > Authentication.
# Providers defined here override and lock any UI provider with the same key.
# LDAP authenticates UI users only. Roles, accounts, S3 users, and S3 connections
# are still granted inside s3-manager by an administrator.
# Provider keys must match [a-z0-9_-]+. TLS_VERIFY=false, ALLOW_INSECURE=true,
# and ALLOW_EMAIL_LINKING=true emit startup security warnings.
# LDAP_PROVIDERS__corp__DISPLAY_NAME=Corporate LDAP
# LDAP_PROVIDERS__corp__URL=ldaps://ldap.example.com:636
# LDAP_PROVIDERS__corp__BIND_DN=cn=s3-manager,ou=services,dc=example,dc=com
# LDAP_PROVIDERS__corp__BIND_PASSWORD=change-me-service-secret
# LDAP_PROVIDERS__corp__USER_BASE_DN=ou=people,dc=example,dc=com
# LDAP_PROVIDERS__corp__USER_FILTER=(|(mail={username})(uid={username})(sAMAccountName={username})(userPrincipalName={username}))
# LDAP_PROVIDERS__corp__EMAIL_ATTRIBUTE=mail
# LDAP_PROVIDERS__corp__NAME_ATTRIBUTE=displayName
# LDAP_PROVIDERS__corp__SUBJECT_ATTRIBUTE=entryUUID
# LDAP_PROVIDERS__corp__START_TLS=false
# LDAP_PROVIDERS__corp__TLS_VERIFY=true
# LDAP_PROVIDERS__corp__TLS_CA_FILE=
# LDAP_PROVIDERS__corp__TIMEOUT_SECONDS=5
# LDAP_PROVIDERS__corp__ENABLED=true
# LDAP_PROVIDERS__corp__ALLOW_INSECURE=false
# LDAP_PROVIDERS__corp__ALLOW_EMAIL_LINKING=false

# Healthchecks (endpoint supervision)
# HEALTHCHECK_ENABLED=true
# HEALTHCHECK_TIMEOUT_SECONDS=5
# HEALTHCHECK_INTERVAL_SECONDS=300
# HEALTHCHECK_RETENTION_DAYS=30
# HEALTHCHECK_DEGRADED_LATENCY_MS=2000
# HEALTHCHECK_VERIFY_SSL=true
# HEALTHCHECK_LATENCY_BASELINE_WINDOW_DAYS=7
# HEALTHCHECK_BASELINE_SAMPLE_SIZE=80
# HEALTHCHECK_RELATIVE_DEGRADED_RATIO=1.8
# HEALTHCHECK_RELATIVE_DEGRADED_MIN_DELTA_MS=200
# HEALTHCHECK_INCIDENT_RECENT_MINUTES=720

# Bucket migrations
# BUCKET_MIGRATION_WORKER_ENABLED=true
# BUCKET_MIGRATION_POLL_INTERVAL_SECONDS=2.0
# BUCKET_MIGRATION_PARALLELISM_MAX=16
# BUCKET_MIGRATION_MAX_ACTIVE_PER_ENDPOINT=2
# BUCKET_MIGRATION_WORKER_LEASE_SECONDS=120
