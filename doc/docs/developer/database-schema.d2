# Generated from backend/app/db SQLAlchemy models via app.db.Base.metadata.
# Scope: all tables and foreign-key topology; use detail slices for readable column-level views.
# Column flags: PK=primary key, FK=foreign key, NN=not nullable, UQ=single-column unique.
# Composite constraints and indexes are available as table tooltips in rendered D2 output.
# Detail slices:
# - doc/docs/developer/database-schema/identity-ui-access.d2 (Identity and UI access)
# - doc/docs/developer/database-schema/storage-s3-execution.d2 (Storage and S3 execution)
# - doc/docs/developer/database-schema/tags-classification.d2 (Tags and classification)
# - doc/docs/developer/database-schema/portal.d2 (Portal)
# - doc/docs/developer/database-schema/operations-audit.d2 (Operations and audit)
# - doc/docs/developer/database-schema/observability-quota-billing.d2 (Observability quota and billing)
# - doc/docs/developer/database-schema/full.d2 (monolithic fallback)
direction: right
classes: {
  table: {
    shape: rectangle
    style.fill: "#ffffff"
    style.stroke: "#64748b"
  }
}

Legend: {
  shape: text
  label: "Overview only: all tables and FK topology. Render per-domain D2 files for readable columns."
}

